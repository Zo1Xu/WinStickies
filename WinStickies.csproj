<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <AppLanguage Condition="'$(AppLanguage)' == ''">zh-CN</AppLanguage>
    <OutputType>WinExe</OutputType><TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AssemblyName>WinStickies.$(AppLanguage)</AssemblyName><RootNamespace>WinStickies</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>assets\WinStickies.ico</ApplicationIcon>
    <OutputPath>dist\</OutputPath><IntermediateOutputPath>obj\$(AppLanguage)\</IntermediateOutputPath><PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit Condition="'$(Prefer32Bit)' == ''">true</Prefer32Bit>
    <DefineConstants Condition="'$(AppLanguage)' == 'en-US'">$(DefineConstants);ENGLISH</DefineConstants>
  </PropertyGroup>
  <Target Name="ValidateAppLanguage" BeforeTargets="BeforeBuild">
    <Error Condition="'$(AppLanguage)' != 'zh-CN' And '$(AppLanguage)' != 'en-US'" Text="AppLanguage must be zh-CN or en-US." />
  </Target>
  <ItemGroup><Reference Include="System" /><Reference Include="System.Core" /><Reference Include="System.Drawing" /><Reference Include="System.Windows.Forms" /><Reference Include="System.Runtime.Serialization" /><Reference Include="System.Xml" /></ItemGroup>
  <ItemGroup><Compile Include="src\*.cs" /></ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
